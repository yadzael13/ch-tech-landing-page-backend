# =========================
# Ports
# =========================
BACKEND_PORT=8000
MYSQL_PORT=3306
REDIS_PORT=6379

# =========================
# Database (docs/DATABASE_SCHEMA.md, docs/adr/0001-mysql-database-privilege-separation.md)
# =========================
# Root credential — used ONLY by database/init/01-create-roles.sh at first
# container init to create the two app-facing users below. Never used by the
# app or by Alembic directly.
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=chtech

# chtech_app: DML only (SELECT/INSERT/UPDATE/DELETE). The running backend
# connects with this — it has no CREATE/ALTER/DROP privilege, so nothing
# running through the app (including a future AI feature) can alter tables.
MYSQL_APP_PASSWORD=changeme-app
DATABASE_URL=mysql+aiomysql://chtech_app:changeme-app@db:3306/chtech?charset=utf8mb4

# chtech_migrator: DDL + DML. Used ONLY by Alembic (alembic/env.py) and by
# the test suite's ephemeral database bootstrap (tests/conftest.py) — never
# by app runtime code.
MYSQL_MIGRATOR_PASSWORD=changeme-migrator
MIGRATION_DATABASE_URL=mysql+aiomysql://chtech_migrator:changeme-migrator@db:3306/chtech?charset=utf8mb4

# Production (RDS/Aurora MySQL): both URLs need TLS. aiomysql/PyMySQL take
# this via connect_args, not a URL query param like asyncpg's `?ssl=require`
# — see docs/DEPLOYMENT.md "Database" for the exact syntax. Not needed here:
# local MySQL runs in the same Docker Compose network.

# =========================
# Backend / Auth (docs/API.md - Token Lifetimes)
# =========================
# HS256 needs >= 32 bytes (RFC 7518 3.2) or PyJWT warns on every token issued.
# Generate a real one for anything beyond local dev: openssl rand -hex 32
JWT_SECRET_KEY=changeme-generate-a-real-32-byte-secret-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# How long a dead (expired/revoked) refresh_tokens row survives before
# app/db/purge_refresh_tokens.py deletes it — see DEPLOYMENT.md for the cron
# wiring. Unrelated to REFRESH_TOKEN_EXPIRE_DAYS above (token validity vs.
# row retention).
REFRESH_TOKEN_RETENTION_DAYS=30

# =========================
# Rate limiting (ADR-0007)
# =========================
REDIS_URL=redis://redis:6379/0

# =========================
# Backend / Seed (dev-only, docs/DATABASE_MIGRATIONS.md - Datos Iniciales)
# =========================
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@ch-tech.dev
SEED_ADMIN_PASSWORD=changeme

# =========================
# Contact notifications (docs/API.md - POST /contact)
# =========================
# Optional — leave commented out to skip the actual send locally; the
# contact request is still persisted either way (API.md: a provider failure
# must never block the request). An empty (uncommented) value is read as ""
# rather than unset, so don't uncomment these without a real key.
# RESEND_API_KEY=re_your_real_key_here
# CONTACT_NOTIFICATION_EMAIL=admin@ch-tech.dev
# CONTACT_NOTIFICATION_FROM=CH-TECH <onboarding@resend.dev>

# =========================
# CORS (docs/ARCHITECTURE.md - the backend serves exactly one frontend)
# =========================
# Local dev default assumes the frontend repo runs `npm run dev` on :3000,
# standalone (no longer sharing a Docker Compose network with this repo —
# see the frontend repo's own .env.example).
FRONTEND_ORIGIN=http://localhost:3000
